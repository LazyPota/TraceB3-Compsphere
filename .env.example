# HTTP Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database (default zero-Docker local Postgres via PGlite; swap for Supabase PostgreSQL URL in staging/prod)
DATABASE_URL=pglite://.data/pglite
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Storage (STORAGE_DRIVER=local|supabase)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=traceb3-evidence

# Chain & Relayer (31337 = local Hardhat, 84532 = Base Sepolia)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
LEDGER_ADDRESS=
RELAYER_PRIVATE_KEY=

# Auth & CORS
JWT_SECRET=change-me-at-least-32-chars-dev-only
SIWE_DOMAIN=localhost:3001
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Domain & Demo Settings
WEIGHT_TOLERANCE_PCT=2
CUSTODY_GAP_HOURS=24
PUBLIC_VIEW_LEVEL=redacted
DEMO_MODE=false
MAX_UPLOAD_MB=10
