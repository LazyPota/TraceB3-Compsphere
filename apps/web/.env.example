# TRACEB3 web (Next.js). All values are public (NEXT_PUBLIC_*) — never put secrets here.
# Hono API base URL (must list this app's origin in the API's FRONTEND_ORIGINS,
# and the API's SIWE_DOMAIN must equal this app's host, e.g. localhost:3000).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public URL of this web app (the API's PUBLIC_APP_URL must match so QR codes resolve to /p/[publicId]).
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3000
# 84532 = Base Sepolia, 31337 = local Hardhat
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# Shows the Demo Controls drawer + demo role guide (requires DEMO_MODE=true on the API for tamper simulation)
NEXT_PUBLIC_DEMO_MODE=true
