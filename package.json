{
  "name": "traceb3-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @traceb3/core test",
    "test:contracts": "pnpm --filter @traceb3/contracts test",
    "test:api": "pnpm --filter @traceb3/api test",
    "clean": "pnpm -r clean",
    "dev:chain": "pnpm --filter @traceb3/contracts dev:chain",
    "dev:api": "pnpm --filter @traceb3/api dev",
    "dev:all": "tsx scripts/dev-all.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.13.14",
    "eslint": "^9.23.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^3.1.1"
  }
}
